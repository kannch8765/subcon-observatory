# Copy to config.local.env (gitignored) and fill in. Real hosts and paths never go in the repo.
SSH_HOST=my-vps
SNAPSHOT_ROOT=~/data/subcon-observatory/snapshots

# Subcon relationship-memory store (dir containing memories.jsonl, batches.jsonl, ...)
STORE_DIR=/path/to/relationship-memory
# Home dir of the Claude-P user (contains .claude/projects and .letta/claude)
CLAUDE_HOME=/path/to/claude-home
# Whisper queue dirs, comma-separated
WHISPER_DIRS=/path/to/claude-home/.letta/claude/subcon-whispers
# Recall runtime logs, comma-separated globs (systemd PrivateTmp paths included)
RECALL_LOG_GLOBS=/tmp/letta-claude-sync-*/recall_runtime.log,/tmp/systemd-private-*/tmp/letta-claude-sync-*/recall_runtime.log
# Subcon git checkouts used for deploys, comma-separated globs
DEPLOY_GIT_GLOBS=/opt/claude-subconscious*
# Letta Postgres (read-only transactions are forced). LETTA_PG_LIBDIR only for a relocated psql.
LETTA_PSQL=psql
LETTA_PG_ARGS=-h 127.0.0.1 -p 5432 -U letta -d letta
LETTA_PG_LIBDIR=
# Optional lower bound for letta* exports (also --since); provider_traces can be GBs
LETTA_SINCE=
# opencode gateway request-log CSVs downloaded from the console, comma-separated globs (read locally, not over SSH)
OPENCODE_CSV_GLOBS=/path/to/downloads/request-logs-*.csv
